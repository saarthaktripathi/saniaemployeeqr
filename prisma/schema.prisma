// Sania Employee Identity & Verification Platform — data model.
// See docs/DATA_MODEL.md for status definitions and design notes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication (Better Auth core + two-factor plugin tables)
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  HR_ADMIN
  HR_STAFF
}

model User {
  id               String   @id
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  twoFactorEnabled Boolean? @default(false)

  /// Application role. Never accepted from client input.
  role             UserRole @default(HR_STAFF)
  /// Disabled users cannot sign in; existing sessions are revoked on disable.
  isActive         Boolean  @default(true)
  /// Additional permissions granted on top of the role (e.g. "employee:create" for HR staff).
  extraPermissions String[] @default([])

  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]

  employeesCreated Employee[]           @relation("EmployeeCreatedBy")
  employeesUpdated Employee[]           @relation("EmployeeUpdatedBy")
  credsIssued      EmployeeCredential[] @relation("CredentialIssuedBy")
  credsRevoked     EmployeeCredential[] @relation("CredentialRevokedBy")
  auditEvents      AuditLog[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

/// Shared (database-backed) rate limit counters so limits hold across app instances.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ---------------------------------------------------------------------------
// Employees
// ---------------------------------------------------------------------------

/// Employment status. Not online presence — see docs/DATA_MODEL.md.
enum EmploymentStatus {
  ACTIVE
  INACTIVE
}

model Employee {
  id               String           @id @default(uuid()) @db.Uuid
  /// Human-readable, immutable, never reused. e.g. SJB-2026-001
  employeeCode     String           @unique
  firstName        String
  lastName         String           @default("")
  displayName      String
  /// Optional; unique (case-insensitive, enforced by the lower() index in migration) when present.
  workEmail        String?
  phone            String?
  department       String
  jobTitle         String
  businessVertical String?
  workLocation     String?
  joiningDate      DateTime?        @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE)
  idIssueDate      DateTime         @db.Date
  idExpiresAt      DateTime         @db.Date
  archivedAt       DateTime?
  /// Optimistic concurrency token; incremented on every update.
  version          Int              @default(1)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  createdById      String?
  updatedById      String?
  createdBy        User?            @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy        User?            @relation("EmployeeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  credentials        EmployeeCredential[]
  verificationEvents VerificationEvent[]

  @@index([employmentStatus])
  @@index([department])
  @@index([idExpiresAt])
  @@index([archivedAt])
  @@index([createdAt, id])
  @@index([displayName])
  @@map("employee")
}

/// Per-prefix, per-year counter used to allocate employee codes atomically.
model EmployeeCodeCounter {
  prefix    String
  year      Int
  lastValue Int    @default(0)

  @@id([prefix, year])
  @@map("employee_code_counter")
}

model EmployeeCredential {
  id               String    @id @default(uuid()) @db.Uuid
  employeeId       String    @db.Uuid
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// SHA-256 of the opaque token — used for lookups. The raw token is never stored in plaintext.
  tokenHash        String    @unique
  /// AES-256-GCM encrypted token so authorized HR can re-display the QR. Null once revoked.
  tokenCiphertext  String?
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokeReason     String?
  issuedById       String?
  revokedById      String?
  issuedBy         User?     @relation("CredentialIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  revokedBy        User?     @relation("CredentialRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  verificationEvents VerificationEvent[]

  @@index([employeeId, issuedAt])
  @@index([expiresAt])
  @@map("employee_credential")
}

// ---------------------------------------------------------------------------
// Audit, verification analytics, real-time outbox, settings
// ---------------------------------------------------------------------------

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

/// Append-only. UPDATE/DELETE are blocked by a database trigger (see migration).
model AuditLog {
  id         BigInt       @id @default(autoincrement())
  createdAt  DateTime     @default(now())
  actorId    String?
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  String?
  action     String
  targetType String?
  targetId   String?
  outcome    AuditOutcome @default(SUCCESS)
  metadata   Json?
  requestId  String?
  /// Keyed hash of the client IP (not the raw IP).
  ipHash     String?

  @@index([createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}

enum VerificationResult {
  VERIFIED
  INACTIVE
  ID_EXPIRED
  CREDENTIAL_EXPIRED
  REVOKED
  UNKNOWN
  MALFORMED
}

model VerificationEvent {
  id           BigInt              @id @default(autoincrement())
  createdAt    DateTime            @default(now())
  result       VerificationResult
  credentialId String?             @db.Uuid
  credential   EmployeeCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  employeeId   String?             @db.Uuid
  employee     Employee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  ipHash       String?

  @@index([createdAt])
  @@index([employeeId, createdAt])
  @@map("verification_event")
}

/// Transactional outbox: rows are written in the same transaction as the change,
/// and a trigger issues pg_notify, which Postgres delivers only after commit.
model OutboxEvent {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now())
  type      String
  payload   Json

  @@index([createdAt])
  @@map("outbox_event")
}

model CompanySettings {
  id                        Int      @id @default(1)
  companyName               String   @default("Sania Job Bowl")
  tagline                   String   @default("Connecting Talent. Creating the Future.")
  employeeIdPrefix          String   @default("SJB")
  defaultIdValidityDays     Int      @default(365)
  credentialValidityDays    Int      @default(365)
  expiryWarningDays         Int      @default(30)
  /// Which optional fields the public verification page may show.
  publicShowJobTitle        Boolean  @default(true)
  publicShowBusinessVertical Boolean @default(true)
  publicShowWorkLocation    Boolean  @default(true)
  publicShowDepartment      Boolean  @default(true)
  auditRetentionDays        Int      @default(730)
  verificationRetentionDays Int      @default(90)
  requireMfaForPrivileged   Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
  updatedById               String?

  @@map("company_settings")
}

/// Fixed-window counters for application endpoints (verification, creation, issuance).
model AppRateLimit {
  key         String @id
  windowStart BigInt
  count       Int

  @@map("app_rate_limit")
}
