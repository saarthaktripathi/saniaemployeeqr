// Sania Employee Identity & Verification Platform — data model.
// See docs/DATA_MODEL.md for status definitions and design notes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication (Better Auth core + two-factor plugin tables)
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  HR_ADMIN
  HR_STAFF
  /// Read-only leadership access (directory, dashboards, ID cards, activity log).
  MANAGEMENT
  /// Line manager: employee workspace plus their reporting tree (team attendance, tasks).
  TEAM_MANAGER
  /// Employee self-service workspace only (own attendance, tasks, leave, profile).
  EMPLOYEE
}

model User {
  id               String   @id
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  twoFactorEnabled Boolean? @default(false)

  /// Application role. Never accepted from client input.
  role             UserRole @default(HR_STAFF)
  /// Disabled users cannot sign in; existing sessions are revoked on disable.
  isActive         Boolean  @default(true)
  /// Additional permissions granted on top of the role (e.g. "employee:create" for HR staff).
  extraPermissions String[] @default([])
  /// The employee record this account belongs to (self-service). Unique: one account per employee.
  employeeId       String?   @unique @db.Uuid
  employee         Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  /// Opt-in: a personal notification for every punch in/out (HR users with attendance access).
  notifyPunches    Boolean   @default(false)

  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]

  employeesCreated  Employee[]             @relation("EmployeeCreatedBy")
  employeesUpdated  Employee[]             @relation("EmployeeUpdatedBy")
  credsIssued       EmployeeCredential[]   @relation("CredentialIssuedBy")
  credsRevoked      EmployeeCredential[]   @relation("CredentialRevokedBy")
  auditEvents       AuditLog[]
  compensationAdded EmployeeCompensation[] @relation("CompensationCreatedBy")
  documentsUploaded EmployeeDocument[]     @relation("DocumentUploadedBy")
  historyRecorded   EmploymentHistory[]    @relation("HistoryCreatedBy")
  accountTokens     AccountToken[]         @relation("AccountTokenUser")
  tokensCreated     AccountToken[]         @relation("AccountTokenCreatedBy")
  notifications     Notification[]
  announcements     Announcement[]
  correctionsRequested AttendanceCorrection[] @relation("CorrectionRequestedBy")
  correctionsReviewed  AttendanceCorrection[] @relation("CorrectionReviewedBy")
  tasksCreated         Task[]                 @relation("TaskCreatedBy")
  tasksReviewed        TaskAssignment[]       @relation("TaskReviewedBy")
  taskComments         TaskComment[]          @relation("TaskCommentAuthor")
  taskFiles            TaskFile[]             @relation("TaskFileUploadedBy")
  leaveReviewed        LeaveRequest[]         @relation("LeaveReviewedBy")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

/// Shared (database-backed) rate limit counters so limits hold across app instances.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ---------------------------------------------------------------------------
// Employees
// ---------------------------------------------------------------------------

/// Employment status. Not online presence — see docs/DATA_MODEL.md.
enum EmploymentStatus {
  ACTIVE
  INACTIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  CONSULTANT
  INTERN
}

enum WorkMode {
  OFFICE
  REMOTE
  HYBRID
}

enum ExitType {
  RESIGNATION
  TERMINATION
  CONTRACT_END
  RETIREMENT
  OTHER
}

/// A company of the Sania group. Every employee belongs to exactly one.
model Company {
  id        String     @id @default(uuid()) @db.Uuid
  /// Unique case-insensitively (lower() index in migration).
  name      String
  /// Optional short code shown next to the name, e.g. "SJB".
  code      String?
  /// Inactive companies keep their employees but cannot receive new ones.
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
  holidays  Holiday[]

  @@map("company")
}

model Employee {
  id                 String           @id @default(uuid()) @db.Uuid
  /// Human-readable, immutable, never reused. e.g. SJB-2026-001 (one sequence for the whole group)
  employeeCode       String           @unique
  firstName          String
  lastName           String           @default("")
  displayName        String
  /// Optional; unique (case-insensitive, enforced by the lower() index in migration) when present.
  workEmail          String?
  phone              String?
  companyId          String           @db.Uuid
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department         String
  /// Designation.
  jobTitle           String
  businessVertical   String?
  employmentType     EmploymentType?
  workMode           WorkMode?
  /// Office city / site.
  workLocation       String?
  team               String?
  reportingManagerId String?          @db.Uuid
  reportingManager   Employee?        @relation("ReportingLine", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports      Employee[]       @relation("ReportingLine")
  /// References into external attendance / leave systems (this app does not track attendance).
  attendanceRef      String?
  leavePolicy        String?
  leaveSystemUrl     String?
  joiningDate        DateTime?        @db.Date
  employmentStatus   EmploymentStatus @default(ACTIVE)
  /// Set by "Record exit" (status becomes INACTIVE); cleared when the employee rejoins.
  exitDate           DateTime?        @db.Date
  exitType           ExitType?
  exitReason         String?
  idIssueDate        DateTime         @db.Date
  idExpiresAt        DateTime         @db.Date
  archivedAt         DateTime?
  /// Storage reference for the profile photo (e.g. "db:<employeeId>"); null when there is none.
  photoKey           String?
  /// Changes on every photo upload; used to bust caches.
  photoUpdatedAt     DateTime?
  /// Optimistic concurrency token; incremented on every update.
  version            Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  createdById        String?
  updatedById        String?
  createdBy          User?            @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy          User?            @relation("EmployeeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  credentials        EmployeeCredential[]
  verificationEvents VerificationEvent[]
  photo              EmployeePhoto?
  compensation       EmployeeCompensation[]
  documents          EmployeeDocument[]
  history            EmploymentHistory[]
  /// Login account linked to this employee (employee self-service), if any.
  user               User?
  accountTokens      AccountToken[]
  attendanceSessions    AttendanceSession[]
  attendanceEvents      AttendanceEvent[]
  attendanceCorrections AttendanceCorrection[]
  taskAssignments       TaskAssignment[]
  leaveRequests         LeaveRequest[]

  @@index([employmentStatus])
  @@index([department])
  @@index([idExpiresAt])
  @@index([archivedAt])
  @@index([createdAt, id])
  @@index([displayName])
  @@index([companyId])
  @@index([jobTitle])
  @@index([reportingManagerId])
  @@map("employee")
}

enum CompensationType {
  SALARY
  STIPEND
  FEE
}

enum PayFrequency {
  ANNUAL
  MONTHLY
  HOURLY
}

/// Salary / stipend / fee revisions. Restricted (compensation:read / compensation:manage);
/// never exported, never public, values never written to the audit log or real-time events.
model EmployeeCompensation {
  id            String           @id @default(uuid()) @db.Uuid
  employeeId    String           @db.Uuid
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          CompensationType
  amount        Decimal          @db.Decimal(14, 2)
  currency      String           @default("INR")
  frequency     PayFrequency
  effectiveFrom DateTime         @db.Date
  notes         String?
  createdAt     DateTime         @default(now())
  createdById   String?
  createdBy     User?            @relation("CompensationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveFrom])
  @@map("employee_compensation")
}

enum DocumentCategory {
  OFFER_LETTER
  APPOINTMENT_LETTER
  CONTRACT
  ID_PROOF
  ADDRESS_PROOF
  EDUCATION
  EXPERIENCE
  RELIEVING_LETTER
  PAYSLIP
  OTHER
}

/// Employee documents and employment records (metadata). Bytes live behind the document
/// store interface (employee_document_blob today; an object store can replace it).
model EmployeeDocument {
  id           String                @id @default(uuid()) @db.Uuid
  employeeId   String                @db.Uuid
  employee     Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category     DocumentCategory
  title        String
  fileName     String
  contentType  String
  size         Int
  storageKey   String
  notes        String?
  uploadedAt   DateTime              @default(now())
  uploadedById String?
  uploadedBy   User?                 @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  blob         EmployeeDocumentBlob?

  @@index([employeeId, uploadedAt])
  @@map("employee_document")
}

model EmployeeDocumentBlob {
  documentId String           @id @db.Uuid
  document   EmployeeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  data       Bytes

  @@map("employee_document_blob")
}

enum HistoryKind {
  JOINED
  DESIGNATION
  DEPARTMENT
  COMPANY
  MANAGER
  EMPLOYMENT_TYPE
  WORK_MODE
  LOCATION
  EXITED
  REJOINED
  NOTE
}

/// Employment history timeline. Entries are recorded automatically when job details change,
/// or added manually (e.g. history from before the system); only manual entries can be removed.
model EmploymentHistory {
  id            String      @id @default(uuid()) @db.Uuid
  employeeId    String      @db.Uuid
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind          HistoryKind
  effectiveDate DateTime    @db.Date
  fromValue     String?
  toValue       String?
  note          String?
  manual        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  createdById   String?
  createdBy     User?       @relation("HistoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveDate])
  @@map("employment_history")
}

/// Profile photo bytes, kept out of the employee row so directory queries stay small.
/// Images are re-encoded server-side (WebP, metadata stripped). Accessed via the photo storage interface.
model EmployeePhoto {
  employeeId  String   @id @db.Uuid
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contentType String
  /// 512x512 card/profile image
  data        Bytes
  /// 96x96 thumbnail for tables and avatars
  thumb       Bytes
  updatedAt   DateTime @updatedAt

  @@map("employee_photo")
}

/// Per-prefix, per-year counter used to allocate employee codes atomically.
model EmployeeCodeCounter {
  prefix    String
  year      Int
  lastValue Int    @default(0)

  @@id([prefix, year])
  @@map("employee_code_counter")
}

model EmployeeCredential {
  id              String    @id @default(uuid()) @db.Uuid
  employeeId      String    @db.Uuid
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// SHA-256 of the opaque token — used for lookups. The raw token is never stored in plaintext.
  tokenHash       String    @unique
  /// AES-256-GCM encrypted token so authorized HR can re-display the QR. Null once revoked.
  tokenCiphertext String?
  issuedAt        DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  revokeReason    String?
  issuedById      String?
  revokedById     String?
  issuedBy        User?     @relation("CredentialIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  revokedBy       User?     @relation("CredentialRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  verificationEvents VerificationEvent[]

  @@index([employeeId, issuedAt])
  @@index([expiresAt])
  @@map("employee_credential")
}

// ---------------------------------------------------------------------------
// Audit, verification analytics, real-time outbox, settings
// ---------------------------------------------------------------------------

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

/// Append-only. UPDATE/DELETE are blocked by a database trigger (see migration).
model AuditLog {
  id         BigInt       @id @default(autoincrement())
  createdAt  DateTime     @default(now())
  actorId    String?
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  String?
  action     String
  targetType String?
  targetId   String?
  outcome    AuditOutcome @default(SUCCESS)
  metadata   Json?
  requestId  String?
  /// Keyed hash of the client IP (not the raw IP).
  ipHash     String?

  @@index([createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}

enum VerificationResult {
  VERIFIED
  INACTIVE
  ID_EXPIRED
  CREDENTIAL_EXPIRED
  REVOKED
  UNKNOWN
  MALFORMED
}

model VerificationEvent {
  id           BigInt              @id @default(autoincrement())
  createdAt    DateTime            @default(now())
  result       VerificationResult
  credentialId String?             @db.Uuid
  credential   EmployeeCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  employeeId   String?             @db.Uuid
  employee     Employee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  ipHash       String?

  @@index([createdAt])
  @@index([employeeId, createdAt])
  @@map("verification_event")
}

/// Transactional outbox: rows are written in the same transaction as the change,
/// and a trigger issues pg_notify, which Postgres delivers only after commit.
model OutboxEvent {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now())
  type      String
  payload   Json

  @@index([createdAt])
  @@map("outbox_event")
}

model CompanySettings {
  id                         Int      @id @default(1)
  companyName                String   @default("Sania Job Bowl")
  tagline                    String   @default("Connecting Talent. Creating the Future.")
  employeeIdPrefix           String   @default("SJB")
  defaultIdValidityDays      Int      @default(365)
  credentialValidityDays     Int      @default(365)
  expiryWarningDays          Int      @default(30)
  /// Which optional fields the public verification page may show.
  publicShowJobTitle         Boolean  @default(true)
  publicShowBusinessVertical Boolean  @default(true)
  publicShowWorkLocation     Boolean  @default(true)
  publicShowDepartment       Boolean  @default(true)
  publicShowPhoto            Boolean  @default(true)
  auditRetentionDays         Int      @default(730)
  verificationRetentionDays  Int      @default(90)
  requireMfaForPrivileged    Boolean  @default(true)
  updatedAt                  DateTime @updatedAt
  updatedById                String?

  @@map("company_settings")
}

// ---------------------------------------------------------------------------
// Employee accounts and notifications (workforce management)
// ---------------------------------------------------------------------------

enum AccountTokenKind {
  INVITE
  PASSWORD_RESET
}

/// Single-use links for employee invitations and password resets. Only the SHA-256 hash of
/// the token is stored; the link is shown once to the HR user who created it.
model AccountToken {
  id          String           @id @default(uuid()) @db.Uuid
  kind        AccountTokenKind
  tokenHash   String           @unique
  /// Login email the account will use (invites) or the account's email (resets).
  email       String
  /// Role granted on acceptance (invites only).
  role        UserRole?
  employeeId  String?          @db.Uuid
  employee    Employee?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?            @relation("AccountTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?            @relation("AccountTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime         @db.Timestamptz(3)
  usedAt      DateTime?        @db.Timestamptz(3)
  revokedAt   DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  @@index([employeeId])
  @@index([userId])
  @@map("account_token")
}

/// In-app notification for one user. `dedupeKey` makes reminder sweeps idempotent.
model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  recipientId String
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        String
  title       String
  body        String?
  /// App-relative path opened from the notification.
  link        String?
  entityType  String?
  entityId    String?
  dedupeKey   String?
  readAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, createdAt])
  @@map("notification")
}

/// HR broadcast; delivered as one notification per recipient.
model Announcement {
  id             String   @id @default(uuid()) @db.Uuid
  title          String
  body           String
  /// { kind: "all" } | { kind: "company", companyId } | { kind: "department", department }
  audience       Json
  recipientCount Int      @default(0)
  createdById    String?
  createdBy      User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@map("announcement")
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

enum AttendanceLocation {
  OFFICE
  WORK_FROM_HOME
  CLIENT_VISIT
}

enum AttendanceSessionStatus {
  OPEN
  CLOSED
  /// Times changed by an approved correction.
  CORRECTED
  /// Excluded from all calculations (entered by mistake); kept for the record.
  VOIDED
}

enum AttendanceEventType {
  PUNCH_IN
  PUNCH_OUT
  SESSION_ADDED
  SESSION_CORRECTED
  SESSION_VOIDED
  SESSION_RESOLVED
}

enum CorrectionKind {
  ADD_SESSION
  CHANGE_TIMES
  CLOSE_SESSION
  VOID_SESSION
}

enum CorrectionStatus {
  PENDING
  APPLIED
  REJECTED
  CANCELLED
}

/// What happens when someone signs out while punched in. Signing out never punches out.
enum LogoutPolicy {
  ALLOW
  WARN
  BLOCK
}

/// Organisation-wide attendance rules (single row). Times are local "HH:MM" in `timezone`.
model AttendancePolicy {
  id                    Int                  @id @default(1)
  timezone              String               @default("Asia/Kolkata")
  shiftStart            String               @default("09:30")
  shiftEnd              String               @default("18:30")
  /// Punch-in after shiftStart + grace counts as late.
  graceMinutes          Int                  @default(15)
  /// Last punch-out earlier than shiftEnd - this counts as an early departure.
  earlyLeaveMinutes     Int                  @default(15)
  fullDayMinutes        Int                  @default(480)
  halfDayMinutes        Int                  @default(240)
  allowMultipleSessions Boolean              @default(true)
  allowedLocations      AttendanceLocation[] @default([OFFICE, WORK_FROM_HOME, CLIENT_VISIT])
  /// 0 = Sunday ... 6 = Saturday
  weeklyOffDays         Int[]                @default([0])
  logoutPolicy          LogoutPolicy         @default(WARN)
  /// An open session older than this is flagged as incomplete.
  maxSessionHours       Int                  @default(16)
  /// How many days back employees may request a correction.
  correctionWindowDays  Int                  @default(7)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)
  updatedById           String?

  @@map("attendance_policy")
}

/// Company holiday (companyId null = every company of the group).
model Holiday {
  id          String   @id @default(uuid()) @db.Uuid
  date        DateTime @db.Date
  name        String
  companyId   String?  @db.Uuid
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([date])
  @@map("holiday")
}

/// One work session (punch in -> punch out). Times are always generated by the server.
model AttendanceSession {
  id              String                  @id @default(uuid()) @db.Uuid
  employeeId      String                  @db.Uuid
  employee        Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Local calendar day of the punch-in (night shifts stay on the day they started).
  workDate        DateTime                @db.Date
  punchInAt       DateTime                @db.Timestamptz(3)
  punchOutAt      DateTime?               @db.Timestamptz(3)
  location        AttendanceLocation
  status          AttendanceSessionStatus @default(OPEN)
  durationSeconds Int?
  /// Set when a session needs HR attention (e.g. closed long after maxSessionHours).
  needsReview     Boolean                 @default(false)
  notes           String?
  reviewNote      String?
  createdById     String?
  closedById      String?
  version         Int                     @default(1)
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(3)
  events          AttendanceEvent[]
  corrections     AttendanceCorrection[]

  @@index([employeeId, workDate])
  @@index([workDate])
  @@map("attendance_session")
}

/// Append-only attendance history (UPDATE/DELETE blocked by trigger, except cascades).
model AttendanceEvent {
  id         BigInt              @id @default(autoincrement())
  employeeId String              @db.Uuid
  employee   Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sessionId  String?             @db.Uuid
  session    AttendanceSession?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type       AttendanceEventType
  occurredAt DateTime            @default(now()) @db.Timestamptz(3)
  /// User id (plain text so history survives user removal).
  actorId    String?
  metadata   Json?

  @@index([employeeId, occurredAt])
  @@index([sessionId])
  @@map("attendance_event")
}

/// Correction requests (from employees) and corrections applied by HR, with before/after.
model AttendanceCorrection {
  id            String             @id @default(uuid()) @db.Uuid
  employeeId    String             @db.Uuid
  employee      Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sessionId     String?            @db.Uuid
  session       AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  kind          CorrectionKind
  status        CorrectionStatus   @default(PENDING)
  workDate      DateTime           @db.Date
  punchInAt     DateTime?          @db.Timestamptz(3)
  punchOutAt    DateTime?          @db.Timestamptz(3)
  location      AttendanceLocation?
  reason        String
  requestedById String?
  requestedBy   User?              @relation("CorrectionRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedById  String?
  reviewedBy    User?              @relation("CorrectionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote    String?
  before        Json?
  after         Json?
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  reviewedAt    DateTime?          @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([employeeId, createdAt])
  @@map("attendance_correction")
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Per-assignee status (each assignee of a task progresses independently).
enum TaskStatus {
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum TaskTarget {
  INDIVIDUAL
  MULTIPLE
  DEPARTMENT
}

enum TaskFileKind {
  /// Instructions/attachments on the task (visible to every assignee).
  BRIEF
  /// Work uploaded by an assignee (visible to them, the assigner and HR).
  DELIVERABLE
}

model Task {
  id           String           @id @default(uuid()) @db.Uuid
  /// Shown as TSK-00042.
  number       Int              @unique @default(autoincrement())
  title        String
  description  String           @default("")
  priority     TaskPriority     @default(MEDIUM)
  target       TaskTarget       @default(INDIVIDUAL)
  /// Department the task was assigned to (target = DEPARTMENT).
  department   String?
  startDate    DateTime?        @db.Date
  dueDate      DateTime?        @db.Date
  createdById  String?
  createdBy    User?            @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledAt  DateTime?        @db.Timestamptz(3)
  cancelReason String?
  version      Int              @default(1)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  assignments  TaskAssignment[]
  comments     TaskComment[]
  files        TaskFile[]
  history      TaskHistory[]

  @@index([createdById, createdAt])
  @@index([dueDate])
  @@map("task")
}

model TaskAssignment {
  id           String        @id @default(uuid()) @db.Uuid
  taskId       String        @db.Uuid
  task         Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId   String        @db.Uuid
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status       TaskStatus    @default(ASSIGNED)
  /// 0-100
  progress     Int           @default(0)
  acceptedAt   DateTime?     @db.Timestamptz(3)
  startedAt    DateTime?     @db.Timestamptz(3)
  submittedAt  DateTime?     @db.Timestamptz(3)
  reviewedAt   DateTime?     @db.Timestamptz(3)
  reviewedById String?
  reviewedBy   User?         @relation("TaskReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?
  version      Int           @default(1)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  comments     TaskComment[]
  files        TaskFile[]

  @@unique([taskId, employeeId])
  @@index([employeeId, status])
  @@index([status])
  @@map("task_assignment")
}

/// Comment thread per assignee (assignee, assigner and HR); other assignees cannot read it.
model TaskComment {
  id           String         @id @default(uuid()) @db.Uuid
  taskId       String         @db.Uuid
  task         Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignmentId String         @db.Uuid
  assignment   TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  authorId     String?
  author       User?          @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body         String
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([assignmentId, createdAt])
  @@map("task_comment")
}

model TaskFile {
  id           String          @id @default(uuid()) @db.Uuid
  taskId       String          @db.Uuid
  task         Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignmentId String?         @db.Uuid
  assignment   TaskAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  kind         TaskFileKind
  fileName     String
  contentType  String
  size         Int
  storageKey   String
  uploadedById String?
  uploadedBy   User?           @relation("TaskFileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  blob         TaskFileBlob?

  @@index([taskId])
  @@index([assignmentId])
  @@map("task_file")
}

model TaskFileBlob {
  fileId String   @id @db.Uuid
  file   TaskFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  data   Bytes

  @@map("task_file_blob")
}

/// Append-only task history (UPDATE/DELETE blocked by trigger, except cascades).
model TaskHistory {
  id           BigInt      @id @default(autoincrement())
  taskId       String      @db.Uuid
  task         Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignmentId String?     @db.Uuid
  actorId      String?
  action       String
  fromStatus   TaskStatus?
  toStatus     TaskStatus?
  progress     Int?
  note         String?
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)

  @@index([taskId, createdAt])
  @@map("task_history")
}

// ---------------------------------------------------------------------------
// Leave
// ---------------------------------------------------------------------------

enum LeaveStatus {
  PENDING
  /// HR asked the employee for more information.
  CLARIFICATION
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveHalfDay {
  NONE
  FIRST_HALF
  SECOND_HALF
}

/// Configurable leave types and yearly quotas (calendar year).
model LeaveType {
  id           String         @id @default(uuid()) @db.Uuid
  code         String         @unique
  name         String
  isPaid       Boolean        @default(true)
  /// Days per calendar year; null = no limit (e.g. unpaid leave).
  annualQuota  Decimal?       @db.Decimal(5, 1)
  allowHalfDay Boolean        @default(true)
  isActive     Boolean        @default(true)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  requests     LeaveRequest[]

  @@map("leave_type")
}

model LeaveRequest {
  id           String       @id @default(uuid()) @db.Uuid
  employeeId   String       @db.Uuid
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  String       @db.Uuid
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  startDate    DateTime     @db.Date
  endDate      DateTime     @db.Date
  /// Single-day requests only.
  halfDay      LeaveHalfDay @default(NONE)
  /// Working days requested (weekly offs and holidays excluded; 0.5 for a half day).
  days         Decimal      @db.Decimal(5, 1)
  reason       String
  status       LeaveStatus  @default(PENDING)
  reviewerId   String?
  reviewer     User?        @relation("LeaveReviewedBy", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote   String?
  /// The employee's reply to a clarification request.
  employeeNote String?
  decidedAt    DateTime?    @db.Timestamptz(3)
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  @@index([employeeId, startDate])
  @@index([status, startDate])
  @@map("leave_request")
}

/// Fixed-window counters for application endpoints (verification, creation, issuance).
model AppRateLimit {
  key         String @id
  windowStart BigInt
  count       Int

  @@map("app_rate_limit")
}
