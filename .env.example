# Copy to .env and fill in. Placeholders only — never commit real secrets.

# PostgreSQL connection string (use the pooled URL on managed hosts).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/sania_local"
# Optional direct (non-pooled) connection used for LISTEN/NOTIFY real-time fan-out.
# Falls back to DATABASE_URL when unset.
DATABASE_DIRECT_URL=""

# Session signing secret, at least 32 random bytes:  openssl rand -base64 48
BETTER_AUTH_SECRET="replace-me"
# Canonical public base URL. QR codes and auth callbacks use this, never the Host header.
APP_BASE_URL="http://localhost:3000"

# 32-byte key (base64) used to encrypt stored QR tokens so HR can re-display them:
#   openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY="replace-me"
# Secret used to hash client IPs in audit/verification logs:  openssl rand -base64 32
IP_HASH_SECRET="replace-me"

# Optional error monitoring endpoint (integration point; unused when empty).
ERROR_MONITORING_DSN=""
# Logging level: debug | info | warn | error
LOG_LEVEL="info"
